# Official server (default). For a local server use ws://localhost:8000/showdown/websocket
PS_SERVER_URL=wss://sim3.psim.us/showdown/websocket
PS_LOGIN_URL=https://play.pokemonshowdown.com/api/
PS_USERNAME=YourBotAccount
PS_PASSWORD=YourBotPassword
PS_FORMAT=gen9championsvgc2026regmbbo3
PS_TEAM_FILE=teams/regmb-team.txt
# challenge | accept
PS_MODE=challenge
PS_OPPONENT=OpponentUsername
# mock | http
AGENT=mock
AGENT_URL=http://127.0.0.1:8787
RUNS_DIR=runs
# Turn the VGC timer on in every game (recommended on the official server)
PS_TIMER=true
